# Yashwant — local development settings (never commit real secrets)
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/ridex
JWT_SECRET=replace-with-at-least-32-random-characters
CLIENT_ORIGIN=http://localhost:5173
# Required for real address search, driving distance and fares.
GOOGLE_MAPS_API=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RideX Support <your-email@example.com>

# Razorpay UPI — backend only. Start with rzp_test_ keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ALLOW_LIVE=false
# Leave blank locally. Set only to your known reverse-proxy hop count.
TRUST_PROXY_HOPS=

# Terminal diagnostics: debug shows each processing step and DB operation (no values).
LOG_LEVEL=debug
# pretty or json
LOG_FORMAT=pretty
ENABLE_CLIENT_LOGS=true
